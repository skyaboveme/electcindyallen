  <circle cx="110" cy="110" r="104" stroke="currentColor" stroke-width="3"></circle>
  <circle cx="110" cy="110" r="92" stroke="currentColor" stroke-width="1" opacity="0.55"></circle>
  <path
    d="M110 38v28M72 86h76M84 86c0 26 10 46 26 56 16-10 26-30 26-56"
    stroke="currentColor"
    stroke-width="5"
    stroke-linecap="round"
  ></path>
  <circle cx="84" cy="82" r="14" stroke="currentColor" stroke-width="4"></circle>
  <circle cx="136" cy="82" r="14" stroke="currentColor" stroke-width="4"></circle>
  <path d="M110 142v22M92 172h36" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
  <text
    x="110"
    y="204"
    text-anchor="middle"
    fill="currentColor"
    font-size="11"
    letter-spacing="3"
    font-family="Cinzel, serif">PRECINCT ONE</text
