---
import { site } from "../data/site";
import Portrait from "./Portrait.astro";
---

<footer class="relative overflow-hidden bg-navy text-cream">
  <div class="star-field pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-4 md:px-6">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3">
        <Portrait variant="logo" class="h-12 w-12" />
        <div>
          <p class="font-mark text-[10px] text-gold">Re-elect</p>
          <p class="font-display text-2xl">{site.honorific}</p>
        </div>
      </div>
      <p class="mt-4 max-w-md text-cream/75">
        {site.office} · {site.county}, {site.state}. Republican nominee on the November 3, 2026 ballot against {site.opponent.name} ({site.opponent.partyAbbr}).
      </p>
    </div>
    <div>
      <p class="font-mark text-[10px] text-gold">On this site</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-gold-soft" href="/about">About Judge Allen</a></li>
        <li><a class="hover:text-gold-soft" href="/the-race">The race</a></li>
        <li><a class="hover:text-gold-soft" href="/vote">How to vote</a></li>
        <li><a class="hover:text-gold-soft" href="/get-involved">Volunteer</a></li>
      </ul>
    </div>
    <div>
      <p class="font-mark text-[10px] text-gold">Court vs. campaign</p>
      <p class="mt-3 text-sm text-cream/75">
        Need the court, not the campaign?
      </p>
      <a
        class="mt-2 inline-block text-sm text-gold-soft underline decoration-gold/40 underline-offset-4"
        href={site.officialCourtUrl}
      >
        Official JP Precinct 1 page
      </a>
    </div>
  </div>
  <div class="relative border-t border-gold/20 px-4 py-6 text-center text-xs leading-relaxed text-cream/60 md:px-6">
    {site.disclaimer}
  </div>
</footer>
