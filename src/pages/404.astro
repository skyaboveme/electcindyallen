---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import { photos } from "../data/site";
---

<Layout title="Page not found" description="This page is not on the Cindy Allen campaign site.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <Photo src={photos.robes} class="mx-auto mb-8 h-32 w-32 rounded-full object-cover object-[center_18%] ring-2 ring-gold" />
    <p class="font-mark text-[11px] text-red">404</p>
    <h1 class="font-display mt-3 text-5xl">This filing isn’t on the docket.</h1>
    <p class="mt-4 text-lg text-muted">The page you wanted isn’t part of the campaign site.</p>
    <a href="/" class="mt-8 inline-block rounded-sm bg-navy px-5 py-3 font-semibold text-cream">Return home</a>
  </section>
</Layout>
