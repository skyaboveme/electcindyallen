---
import Layout from "../layouts/Layout.astro";
import VolunteerForm from "../components/VolunteerForm";
import { site } from "../data/site";
---

<Layout
  title="Contact"
  description="Contact the Cindy Allen campaign for Justice of the Peace, Precinct 1. Court business belongs on the official Bastrop County JP page."
>
  <section class="hero-wash relative py-16 text-cream">
    <div class="star-field absolute inset-0"></div>
    <div class="relative mx-auto max-w-4xl px-4 md:px-6">
      <p class="font-mark text-[11px] text-gold">Campaign desk</p>
      <h1 class="font-display mt-3 text-5xl">Write the campaign — not the court.</h1>
      <p class="mt-5 max-w-2xl text-lg text-cream/80">
        Filings, dockets, payments, and case questions go to the official office. Volunteer notes, sign requests, and endorsements come here.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:px-6">
    <div>
      <h2 class="font-display text-3xl">Campaign message</h2>
      <div class="mt-6">
        <VolunteerForm client:load formspreeId={site.formspreeId} campaignEmail={site.campaignEmail} />
      </div>
    </div>
    <div class="space-y-6">
      <div class="rounded-sm border border-red/30 bg-white p-6">
        <h3 class="font-display text-2xl">If you have a case</h3>
        <p class="mt-3 text-muted">
          Clerks cannot give legal advice. Use the county page for hours, forms, and contact names.
        </p>
        <a href={site.officialCourtUrl} class="mt-4 inline-block font-semibold text-red-deep">
          Official JP Precinct 1 →
        </a>
        <p class="mt-4 text-sm text-muted">
          Court address published by the county: 803 Pine Street, Bastrop (historic courthouse). Hours Monday–Friday, 8 a.m.–4 p.m.
        </p>
      </div>
      <div class="parchment rounded-sm border border-gold/40 p-6">
        <h3 class="font-display text-2xl">Campaign contacts</h3>
        <ul class="mt-3 space-y-2 text-muted">
          <li>Email: {site.campaignEmail || "Add campaignEmail in src/data/site.ts"}</li>
          <li>Phone: {site.campaignPhone || "Add campaignPhone in src/data/site.ts"}</li>
          <li>
            Social: {
              site.facebookUrl ? (
                <a href={site.facebookUrl}>Facebook</a>
              ) : (
                "Add facebookUrl when the page is live"
              )
            }
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
