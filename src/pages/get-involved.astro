---
import Layout from "../layouts/Layout.astro";
import VolunteerForm from "../components/VolunteerForm";
import Portrait from "../components/Portrait.astro";
import { site } from "../data/site";
---

<Layout
  title="Get Involved"
  description="Volunteer or take a yard sign to re-elect Judge Cindy Allen for Justice of the Peace, Precinct 1 in Bastrop County."
>
  <section class="hero-wash relative py-16 text-cream">
    <div class="star-field absolute inset-0"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-[1.2fr_0.8fr] md:px-6">
      <div>
        <p class="font-mark text-[11px] text-gold">Campaign · Precinct 1</p>
        <h1 class="font-display mt-3 text-5xl">This race is won on porches and at the polls.</h1>
        <p class="mt-5 max-w-2xl text-lg text-cream/80">
          Yard signs, block walks, phone banks, and poll greeters. Tell the campaign how you can help.
        </p>
      </div>
      <Portrait variant="hero" class="hidden max-w-xs md:block" />
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-[1.1fr_0.9fr] md:px-6">
    <div>
      <p class="font-mark text-[11px] text-red">Volunteer card</p>
      <h2 class="font-display mt-2 mb-6 text-4xl">Sign up</h2>
      <VolunteerForm client:load campaignEmail={site.campaignEmail} />
    </div>
    <aside class="space-y-6">
      <div class="parchment rounded-sm border border-gold/40 p-6">
        <p class="font-mark text-[10px] text-red">Campaign desk</p>
        <h2 class="font-display mt-2 text-3xl">Email the campaign</h2>
        <a href={`mailto:${site.campaignEmail}`} class="mt-4 inline-block text-lg font-semibold text-red-deep">
          {site.campaignEmail}
        </a>
      </div>
      <div class="rounded-sm border border-navy/10 bg-white p-6">
        <h3 class="font-display text-2xl">Ways to help this week</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
          <li>Put a sign in a Precinct 1 yard that faces the street.</li>
          <li>Text five neighbors the Election Day date and the office title.</li>
          <li>Share the race page so people know both names on the ballot.</li>
          <li>Offer two hours during early voting, October 19–30.</li>
        </ul>
      </div>
    </aside>
  </section>
</Layout>
