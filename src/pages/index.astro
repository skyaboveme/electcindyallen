---
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown";
import Portrait from "../components/Portrait.astro";
import TexasOutline from "../components/TexasOutline.astro";
import FaqList from "../components/FaqList";
import Photo from "../components/Photo.astro";
import { experience, faqs, photos, priorities, site } from "../data/site";
import { formatCalendarDate } from "../lib/dates";
import { getCollection } from "astro:content";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
).slice(0, 3);

const events = (await getCollection("events"))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .filter((event) => event.data.featured)
  .slice(0, 3);
---

<Layout>
  <section class="hero-wash relative overflow-hidden text-cream">
    <div class="star-field absolute inset-0"></div>
    <TexasOutline class="pointer-events-none absolute -right-16 top-10 h-[34rem] w-[34rem] text-gold/10" />
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-[1.15fr_0.85fr] md:px-6 md:py-24">
      <div>
        <p class="font-mark text-[11px] text-gold">
          Re-elect · Republican · November 3, 2026
        </p>
        <h1 class="font-display mt-4 text-5xl leading-[1.05] text-cream md:text-7xl">
          Judge<br />Cindy Allen
        </h1>
        <p class="mt-4 max-w-xl text-lg text-cream/80 md:text-xl">
          Justice of the Peace, Precinct 1 · Bastrop County, Texas
        </p>
        <p class="mt-5 max-w-xl text-cream/75">
          The sitting judge. The experienced choice. On the ballot against {site.opponent.name} ({site.opponent.partyAbbr}).
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/get-involved" class="rounded-sm bg-red px-5 py-3 font-semibold hover:bg-red-deep">Volunteer</a>
          <a href="/vote" class="rounded-sm border border-gold px-5 py-3 font-semibold text-gold-soft hover:bg-gold/10">Vote Nov 3</a>
          <a href="/the-race" class="rounded-sm px-5 py-3 font-semibold text-cream/80 underline decoration-gold/50 underline-offset-4">See the race</a>
        </div>
        <div class="mt-10 max-w-md">
          <p class="font-mark mb-3 text-[10px] text-gold-soft">Until polls open</p>
          <Countdown client:load isoDate={site.electionDay} />
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <Portrait variant="hero" class="w-72 md:w-[22rem]" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <div class="grid gap-4 md:grid-cols-3">
      <figure class="overflow-hidden rounded-sm border border-gold/40">
        <Photo src={photos.truck} class="h-64 w-full object-cover object-[center_32%]" />
        <figcaption class="bg-navy px-3 py-2 text-sm text-cream">Re-elect · Precinct One</figcaption>
      </figure>
      <figure class="overflow-hidden rounded-sm border border-gold/40">
        <Photo src={photos.parade} class="h-64 w-full object-cover object-[center_30%]" />
        <figcaption class="bg-navy px-3 py-2 text-sm text-cream">Out in the community</figcaption>
      </figure>
      <figure class="overflow-hidden rounded-sm border border-gold/40">
        <Photo src={photos.downtown} class="h-64 w-full object-cover object-center" />
        <figcaption class="bg-navy px-3 py-2 text-sm text-cream">Downtown Bastrop</figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-red text-cream">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 md:flex-row md:items-center md:justify-between md:px-6">
      <p class="font-mark text-[10px]">General election ballot</p>
      <p class="font-display text-xl md:text-2xl">
        Cindy Allen (R) · {site.opponent.name} (D)
      </p>
      <p class="text-sm text-cream/80">Justice of the Peace, Precinct 1</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <p class="font-mark text-[11px] text-red">The record</p>
    <h2 class="font-display mt-2 max-w-3xl text-4xl md:text-5xl">A justice court is only as steady as the judge who holds it.</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Since 2019, Judge Allen has been Precinct 1’s justice of the peace — the local bench for fine-only cases, small civil claims, evictions, warrants, inquests, and marriages. Precinct 1 already knows her work.
    </p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        experience.map((item) => (
          <article class="rounded-sm border border-navy/10 bg-white p-6">
            <p class="font-mark text-[10px] text-gold">{item.meta}</p>
            <h3 class="font-display mt-2 text-2xl">{item.title}</h3>
            <p class="mt-3 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-navy py-16 text-cream">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="font-mark text-[11px] text-gold">Docket of priorities</p>
      <h2 class="font-display mt-2 text-4xl">What this court owes Precinct 1</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          priorities.slice(0, 3).map((item) => (
            <article class="border border-gold/25 p-5">
              <p class="font-mark text-[10px] text-gold">Cause {item.docket}</p>
              <h3 class="font-display mt-2 text-2xl">{item.title}</h3>
              <p class="mt-3 text-cream/75">{item.body}</p>
            </article>
          ))
        }
      </div>
      <a href="/priorities" class="mt-8 inline-block text-gold-soft underline decoration-gold/40 underline-offset-4">Read the full docket</a>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:px-6">
    <div>
      <p class="font-mark text-[11px] text-red">Dates that matter</p>
      <h2 class="font-display mt-2 text-4xl">The calendar is live.</h2>
      <ol class="mt-6 space-y-4">
        {
          events.map((event) => (
            <li class="border-l-2 border-gold pl-4">
              <p class="text-sm text-muted">
                {formatCalendarDate(event.data.date)}
              </p>
              <p class="font-display text-xl">{event.data.title}</p>
            </li>
          ))
        }
      </ol>
      <a href="/vote" class="mt-6 inline-block font-semibold text-red-deep">Full voting guide →</a>
    </div>
    <div>
      <p class="font-mark text-[11px] text-red">From the campaign</p>
      <h2 class="font-display mt-2 text-4xl">News</h2>
      <div class="mt-6 space-y-5">
        {
          news.map((post) => (
            <a href={`/news/${post.id}`} class="block rounded-sm border border-navy/10 bg-white p-5 hover:border-gold">
              <p class="text-sm text-muted">
                {formatCalendarDate(post.data.pubDate)}
              </p>
              <h3 class="font-display mt-1 text-2xl">{post.data.title}</h3>
              <p class="mt-2 text-muted">{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 md:px-6">
    <p class="font-mark text-[11px] text-red">Questions</p>
    <h2 class="font-display mt-2 mb-6 text-4xl">Straight answers</h2>
    <FaqList client:visible items={[...faqs]} />
  </section>

  <section class="parchment mx-4 mb-20 mt-8 rounded-sm border border-gold/40 px-6 py-12 text-center md:mx-auto md:max-w-5xl">
    <p class="font-mark text-[11px] text-red">Precinct 1 · Bastrop County</p>
    <h2 class="font-display mt-3 text-4xl md:text-5xl">Keep an experienced judge on the people’s court.</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">{site.slogan}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/get-involved" class="rounded-sm bg-red px-5 py-3 font-semibold text-cream">Join the campaign</a>
      <a href="/about" class="rounded-sm border border-navy/20 bg-white px-5 py-3 font-semibold">Read her record</a>
    </div>
  </section>
</Layout>
