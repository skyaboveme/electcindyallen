---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import { jpDuties, photos, priorities } from "../data/site";
---

<Layout
  title="Priorities"
  description="Judge Cindy Allen’s campaign priorities for Bastrop County Justice of the Peace, Precinct 1: a fair courtroom, timely dockets, and experienced magistrate work."
>
  <section class="hero-wash relative py-16 text-cream">
    <div class="star-field absolute inset-0"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:px-6">
      <div>
        <p class="font-mark text-[11px] text-gold">Cause list</p>
        <h1 class="font-display mt-3 text-5xl">A docket worthy of Precinct 1.</h1>
        <p class="mt-5 max-w-2xl text-lg text-cream/80">
          Justice court is not theory. It is the Tuesday morning setting, the eviction file, the warrant, and the person at the clerk’s window who just wants a straight answer.
        </p>
      </div>
      <figure class="overflow-hidden rounded-sm border border-gold/40">
        <Photo src={photos.office} class="max-h-[28rem] w-full object-cover object-[center_20%]" />
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 md:px-6">
    <ol class="space-y-6">
      {
        priorities.map((item) => (
          <li class="grid gap-4 rounded-sm border border-navy/10 bg-white p-6 md:grid-cols-[7rem_1fr]">
            <p class="font-mark text-gold">No. {item.docket}</p>
            <div>
              <h2 class="font-display text-3xl">{item.title}</h2>
              <p class="mt-3 text-lg text-muted">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-pine py-16 text-cream">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="font-mark text-[11px] text-gold-soft">The office</p>
      <h2 class="font-display mt-2 text-4xl">What a Texas justice of the peace actually does</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          jpDuties.map((item) => (
            <article class="border border-gold/25 p-5">
              <h3 class="font-display text-2xl">{item.title}</h3>
              <p class="mt-3 text-cream/80">{item.body}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 max-w-3xl text-sm text-cream/70">
        Jurisdiction summary follows the Texas Constitution, Article V, Section 19, and Bastrop County’s published description of JP Precinct 1. Civil jurisdictional amount is $20,000.
      </p>
    </div>
  </section>
</Layout>
