---
import Layout from "../../layouts/Layout.astro";
import Photo from "../../components/Photo.astro";
import { photos } from "../../data/site";
import { formatCalendarDate } from "../../lib/dates";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Layout title="News" description="Updates from the Cindy Allen campaign for Bastrop County Justice of the Peace, Precinct 1.">
  <section class="hero-wash relative py-16 text-cream">
    <div class="star-field absolute inset-0"></div>
    <div class="relative mx-auto max-w-4xl px-4 md:px-6">
      <p class="font-mark text-[11px] text-gold">Dispatches</p>
      <h1 class="font-display mt-3 text-5xl">Campaign news</h1>
      <p class="mt-5 text-lg text-cream/80">Updates from the campaign trail in Precinct 1.</p>
    </div>
  </section>

  <figure class="mx-auto max-w-4xl px-4 md:px-6">
    <Photo src={photos.parade} class="-mt-8 h-64 w-full rounded-sm object-cover object-[center_30%] ring-1 ring-gold/40" />
  </figure>

  <section class="mx-auto max-w-4xl space-y-5 px-4 py-16 md:px-6">
    {
      posts.map((post) => (
        <a href={`/news/${post.id}`} class="block rounded-sm border border-navy/10 bg-white p-6 hover:border-gold">
          <p class="font-mark text-[10px] text-red">{post.data.kicker ?? "Update"}</p>
          <h2 class="font-display mt-2 text-3xl">{post.data.title}</h2>
          <p class="mt-1 text-sm text-muted">
            {formatCalendarDate(post.data.pubDate)}
          </p>
          <p class="mt-3 text-muted">{post.data.description}</p>
        </a>
      ))
    }
  </section>
</Layout>
