---
import Layout from "../../layouts/Layout.astro";
import Photo from "../../components/Photo.astro";
import { photos } from "../../data/site";
import { formatCalendarDate } from "../../lib/dates";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <p class="font-mark text-[11px] text-red">{post.data.kicker ?? "Update"}</p>
    <h1 class="font-display mt-3 text-5xl">{post.data.title}</h1>
    <p class="mt-3 text-muted">
      {formatCalendarDate(post.data.pubDate)}
    </p>
    <figure class="my-8 overflow-hidden rounded-sm border border-gold/40">
      <Photo src={photos.downtown} class="max-h-80 w-full object-cover object-center" />
    </figure>
    <div class="prose-campaign">
      <Content />
    </div>
    <a href="/news" class="mt-10 inline-block font-semibold text-red-deep">← All news</a>
  </article>
</Layout>
