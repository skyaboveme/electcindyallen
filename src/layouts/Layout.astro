---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionBar from "../components/ActionBar.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  kicker?: string;
}

const {
  title = site.tagline,
  description = `${site.honorific} is running for re-election as ${site.office} in ${site.county}, ${site.state}, against ${site.opponent.name} (${site.opponent.partyAbbr}).`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const pageTitle = title.includes(site.candidate) ? title : `${title} · ${site.candidate}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/cindy-allen-logo.png" />
    <meta name="theme-color" content="#071422" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", site.url).toString()} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.jpg", site.url).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,750&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: site.honorific,
      jobTitle: site.office,
      affiliation: {
        "@type": "Organization",
        name: "Republican Party",
      },
      description,
      url: site.url,
      image: new URL("/cindy-allen-logo.png", site.url).toString(),
      address: {
        "@type": "PostalAddress",
        addressLocality: "Bastrop",
        addressRegion: "TX",
        addressCountry: "US",
      },
    })} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:text-navy"
    >
      Skip to content
    </a>
    <div class="flag-stripe h-1.5 w-full"></div>
    <Header />
    <main id="main" class="pb-20 md:pb-0">
      <slot />
    </main>
    <Footer />
    <ActionBar />
  </body>
</html>
